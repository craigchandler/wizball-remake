# syntax=docker/dockerfile:1
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ARMHF_SYSROOT=/opt/armhf-sysroot

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    python3 \
    crossbuild-essential-armhf \
 && rm -rf /var/lib/apt/lists/*

# Resolve armhf dependencies separately because the native and ports mirrors
# can publish different versions of packages that APT requires to match.
RUN <<'BUILD_SYSROOT'
set -eu
apt_state=$(mktemp -d)
chmod 755 "$apt_state"
mkdir -p "$apt_state/lists/partial" "$apt_state/archives/partial" "$ARMHF_SYSROOT"
touch "$apt_state/status"
cat > "$apt_state/sources.list" <<'APT_SOURCES'
deb http://ports.ubuntu.com/ubuntu-ports jammy main universe
deb http://ports.ubuntu.com/ubuntu-ports jammy-updates main universe
deb http://ports.ubuntu.com/ubuntu-ports jammy-security main universe
APT_SOURCES
cat > "$apt_state/apt.conf" <<APT_CONFIG
APT::Architecture "armhf";
APT::Architectures { "armhf"; };
Dir::Etc::sourcelist "$apt_state/sources.list";
Dir::Etc::sourceparts "-";
Dir::State::status "$apt_state/status";
Dir::State::lists "$apt_state/lists";
Dir::Cache::archives "$apt_state/archives";
APT_CONFIG
apt-get -c "$apt_state/apt.conf" update
apt-get -c "$apt_state/apt.conf" install -y --download-only --no-install-recommends \
    libc6-dev libsdl2-dev libsdl2-mixer-dev libsdl2-image-dev libgles2-mesa-dev
for package in "$apt_state/archives/"*.deb; do
    dpkg-deb -x "$package" "$ARMHF_SYSROOT"
done
rm -rf "$apt_state"
BUILD_SYSROOT

# CMake toolchain file for armhf cross-compilation
RUN <<'WRITE_TOOLCHAIN'
cat > /toolchain-armhf.cmake <<'CMAKE_TOOLCHAIN'
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7l)
set(CMAKE_C_COMPILER arm-linux-gnueabihf-gcc)
set(CMAKE_CXX_COMPILER arm-linux-gnueabihf-g++)
set(CMAKE_SYSROOT "$ENV{ARMHF_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib/arm-linux-gnueabihf/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
CMAKE_TOOLCHAIN
WRITE_TOOLCHAIN

WORKDIR /workspace
